{
	"name": "prairie-ash/theme",
	"description": "Coding standards tooling for the Prairie Ash theme.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"fix": "phpcbf"
	}
}
