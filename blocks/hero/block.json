{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "prairie-ash/hero",
	"title": "Hero",
	"description": "The home sign: heading on two lines, small title, labels, text, a button and a link, and the window photo with its caption.",
	"category": "prairie-ash",
	"icon": "cover-image",
	"keywords": [
		"hero",
		"sign",
		"home"
	],
	"textdomain": "prairie-ash",
	"attributes": {
		"className": {
			"type": "string"
		},
		"paStyle": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"anchor": true,
		"align": false,
		"html": false,
		"customCSS": false,
		"customClassName": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": false,
			"link": false,
			"enableContrastChecker": false,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"padding": [
				"top",
				"bottom",
				"left",
				"right"
			],
			"margin": [
				"top",
				"bottom"
			],
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"padding": true,
				"margin": true
			}
		},
		"dimensions": {
			"minHeight": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"minHeight": true
			}
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"backgroundImage": true
			}
		}
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"field_pa_hero_title_line_1": "We roast our coffee",
				"field_pa_hero_title_line_2": "behind a glass wall"
			}
		}
	},
	"acf": {
		"blockVersion": 3,
		"renderTemplate": "render.php",
		"autoInlineEditing": false
	}
}
